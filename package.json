{
  "name": "multimodal-video-platform",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e:smoke": "npm run build && node scripts/e2e/run-mvp-smoke.mjs",
    "load:100": "npm run build && node scripts/load/run-100-concurrency.mjs"
  }
}

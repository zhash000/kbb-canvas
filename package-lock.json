{
  "name": "multimodal-video-platform",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "multimodal-video-platform",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
      "name": "@app/api",
      "version": "0.0.0"
    },
    "apps/desktop": {
      "name": "@app/desktop",
      "version": "0.0.0"
    },
    "apps/worker": {
      "name": "@app/worker",
      "version": "0.0.0"
    },
    "node_modules/@app/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@app/desktop": {
      "resolved": "apps/desktop",
      "link": true
    },
    "node_modules/@app/model-catalog": {
      "resolved": "packages/model-catalog",
      "link": true
    },
    "node_modules/@app/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@app/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "packages/model-catalog": {
      "name": "@app/model-catalog",
      "version": "0.0.0"
    },
    "packages/shared": {
      "name": "@app/shared",
      "version": "0.0.0"
    }
  }
}
